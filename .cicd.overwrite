---

# Generic
generic:
  role: ansible-role-asciinema_player
  role_short: asciinema_player
  role_description: |
    Set-up a webserver to hosts asciinema files
  collections: []

# Supported platforms
platforms:
  rockylinux8:
    supported: true
    ci: false
  rockylinux9:
    supported: true
    ci: false
  rockylinux10:
    supported: true
    ci: false
  oraclelinux8:
    supported: true
    ci: false
  oraclelinux9:
    supported: true
    ci: false
  oraclelinux10:
    supported: true
    ci: false
  almalinux8:
    supported: true
    ci: false
  almalinux9:
    supported: true
    ci: false
  almalinux10:
    supported: true
    ci: false
  debian11:
    supported: true
    ci: false
  debian12:
    supported: true
    ci: false
  debian13:
    supported: true
    ci: false
  ubuntu1804:
    supported: true
    ci: false
  ubuntu2004:
    supported: true
    ci: false
  ubuntu2204:
    supported: true
    ci: false
  ubuntu2404:
    supported: true
    ci: false
  fedora42:
    supported: true
    ci: false
  fedora43:
    supported: true
    ci: false
  alpine3:
    supported: true
    ci: false
  docker:
    supported: true
    ci: true

# Molecule
molecule:
  requirements:
    roles_extra:
      - deitkrachten.nginx_docker
      - deitkrachten.openssl
  converge:
    roles:
      - deitkrachten.nginx_docker
    vars:
      asciinema_fqdn: asciinema.example.com
      asciinema_cast_path: files
      asciinema_html_path: /export/docker/nginx/html
      nginx_docker_environment: []
      nginx_docker_networks: []
